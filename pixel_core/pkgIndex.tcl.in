# -*- tcl -*-
# Tcl package index file
#
package ifneeded @PACKAGE_NAME@ @PACKAGE_VERSION@ [list apply {
	dir {
		load [file join $dir @PKG_LIB_FILE@] [string totitle @PACKAGE_NAME@]
		source [file join $dir utils.tcl]
	}
} $dir]
package ifneeded [string totitle @PACKAGE_NAME@] @PACKAGE_VERSION@ [list apply {
	dir {
		load [file join $dir @PKG_LIB_FILE@] [string totitle @PACKAGE_NAME@]
		source [file join $dir utils.tcl]
	}
} $dir]
